# Copy this file to locals.auto.tf and replace the example values before use.
# Keep secret values in Secrets Manager; only secret ARNs belong here.
locals {
  aws_region  = "us-east-1"
  name        = "sql-mcp-gateway-prod"
  environment = "production"

  # Build and push deploy/docker/lambda.Dockerfile before creating the function.
  # Use the immutable image digest returned by ECR, not a mutable tag.
  lambda_image_uri = "123456789012.dkr.ecr.us-east-1.amazonaws.com/sql-mcp-gateway-lambda@sha256:REPLACE_WITH_IMAGE_DIGEST"

  # Existing private network resources in the VPC containing RDS and Vault.
  private_subnet_ids          = ["subnet-0123456789abcdef0", "subnet-0abcdef0123456789"]
  lambda_security_group_ids   = ["sg-0123456789abcdef0"]
  execute_api_vpc_endpoint_id = "vpce-0123456789abcdef0"

  # Existing Secrets Manager entries; these values are ARNs, never secret contents.
  control_database_url_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:sql-mcp-gateway/control-database-url-EXAMPLE"
  vault_credentials_secret_arn    = "arn:aws:secretsmanager:us-east-1:123456789012:secret:sql-mcp-gateway/vault-credentials-EXAMPLE"
  secret_kms_key_arns             = []

  oidc_issuer_url               = "https://identity.example.internal/issuer"
  oidc_client_id                = "sql-mcp-gateway-admin"
  oidc_access_token_audience    = "sql-mcp-gateway"
  oidc_bootstrap_admin_subjects = ["REPLACE_WITH_EXACT_OIDC_SUBJECT"]
  vault_address                 = "https://vault.example.internal:8200"

  max_query_rows                 = 200
  max_query_duration_seconds     = 18
  lambda_memory_mb               = 1024
  lambda_timeout_seconds         = 28
  reserved_concurrent_executions = 5
  api_stage_name                 = "prod"
  api_rate_limit_per_second      = 5
  api_burst_limit                = 10
  log_retention_in_days          = 30
}
